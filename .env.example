### Backend
# development | test | production
ENVIRONMENT=development

# SQLAlchemy URL (use Postgres in production)
DATABASE_URL=sqlite:///./knp_connect.db

# Required in production
SECRET_KEY=change-me-to-a-long-random-secret

# Comma-separated
CORS_ORIGINS=http://localhost:5173

# Optional
PUBLIC_BASE_URL=http://localhost:8000

### Redis (rate limiting + realtime fanout)
REDIS_URL=redis://localhost:6379/0

### S3 / MinIO (media uploads)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=knp-connect
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/knp-connect

### Google OAuth
GOOGLE_CLIENT_ID=

### SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

### Frontend
VITE_API_URL=http://localhost:8000

